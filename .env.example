# Vulture Bot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Vulture Bot
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://vulture:vulture_secret@localhost:5432/vulturebot
# SQLite (local development alternative)
# DATABASE_URL=sqlite+aiosqlite:///./vulture_bot.db

# =============================================================================
# AI PROVIDERS
# =============================================================================
# Ollama (primary, free, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Google Gemini (optional)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash

# Active provider: ollama | gemini
AI_PROVIDER=ollama

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# =============================================================================
# EMAIL
# =============================================================================
# Provider: mock | gmail | smtp
EMAIL_PROVIDER=mock

# Gmail API OAuth (separate from sign-in)
# GMAIL_CLIENT_ID=your-gmail-client-id
# GMAIL_CLIENT_SECRET=your-gmail-client-secret

# SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=csv,xlsx,xls,pdf,docx,doc,txt,json,xml

# =============================================================================
# SECURITY
# =============================================================================
SESSION_COOKIE_NAME=vulture_session
SESSION_MAX_AGE=86400
RATE_LIMIT_PER_MINUTE=60
ADMIN_EMAILS=admin@example.com

# =============================================================================
# REDIS (for background tasks)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
